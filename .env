# ============================================================================
# PostgreSQL MCP Server - Environment Configuration
# ============================================================================
# This IS a template file with placeholder values. Copy your real credentials
# to .env.local (git-ignored) or edit this file directly with real values —
# just NEVER commit real keys/passwords to version control.
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database
DATABASE_USER=your_user
DATABASE_PASSWORD=your_password
DATABASE_MIN_POOL_SIZE=2
DATABASE_MAX_POOL_SIZE=5

# ============================================================================
# MULTI-DATABASE CONFIGURATION (OPTIONAL)
# ============================================================================
# Register additional databases as a JSON object; each entry accepts the same
# fields as the single-database settings above. Queries route via the
# `database` parameter; omitting it with multiple DBs configured returns a
# database_error listing all available names.
#
# DATABASES={"db2": {"host": "localhost", "port": 5432, "name": "db2", "user": "your_user", "password": "your_password", "min_pool_size": 2, "max_pool_size": 5}}

# ============================================================================
# OPENAI CONFIGURATION (official OpenAI or any OpenAI-compatible provider)
# ============================================================================
OPENAI_API_KEY=sk-your-api-key-here
# For OpenAI official API keep the default; for third-party providers set
# their /v1 endpoint and a matching model name, e.g.:
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=90

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Read-only enforcement (keep false in production)
SECURITY_ALLOW_WRITE_OPERATIONS=false
# Max rows per query (memory protection)
SECURITY_MAX_ROWS=10000
# Sensitive objects protection: queries touching these are rejected with
# security_violation (comma-separated or JSON array)
# SECURITY_BLOCKED_TABLES=sensitive_table,audit_log
# SECURITY_BLOCKED_COLUMNS=password,id_card
# Allow EXPLAIN statements (default false)
# SECURITY_ALLOW_EXPLAIN=false

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================
# Prometheus metrics endpoint (true exposes /metrics on METRICS_PORT)
# Note: multi-instance deployments should keep false or vary ports to avoid conflicts
OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_METRICS_PORT=9091
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=json

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
# Persistent schema cache: process restarts skip slow introspection
# (1000+ table DB drops from ~40s to ~1s cold start). Empty disables it.
CACHE_PERSIST_DIR=.schema_cache
# Disk cache TTL in seconds (independent of in-memory CACHE_SCHEMA_TTL=3600)
CACHE_DISK_TTL=86400

# ============================================================================
# RESILIENCE CONFIGURATION
# ============================================================================
# Retry with exponential backoff
RESILIENCE_MAX_RETRIES=3
RESILIENCE_RETRY_DELAY=1.0
RESILIENCE_BACKOFF_FACTOR=2.0
# Rate limiting for LLM calls and SQL execution
RESILIENCE_QUERY_RATE_LIMIT=10
RESILIENCE_LLM_RATE_LIMIT=5
